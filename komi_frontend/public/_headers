# Cabeceras de Cloudflare Pages (SRS 19.23). Vite copia este archivo a dist/.
# El Service Worker, el shell y el manifest nunca se cachean sin revalidar: si no, una version
# vieja de sw.js dejaria a los lectores sin actualizaciones. Los archivos con hash en el nombre
# no cambian nunca, asi que se cachean un anio.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400
