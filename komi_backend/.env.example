# Copiar a .env y completar. Nunca subir .env al repositorio.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Formato: postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE?sslmode=require&connect_timeout=10
# Solo se admiten sslmode y connect_timeout. La clave se escribe con %-escapes si lleva
# caracteres especiales (@ = %40, / = %2F, : = %3A). En produccion (pooler de Supabase en modo
# sesion) usa sslmode=require y el usuario postgres.<proyecto>.
DATABASE_URL=postgresql://komi_user:TU_CLAVE@localhost:5432/komi_db
# Segundos que se mantiene abierta cada conexion a la base de datos. 0 (por defecto) la cierra
# al terminar cada peticion; con el pooler de Supabase cada conexion ocupa un hueco limitado.
DB_CONN_MAX_AGE=0
GEMINI_API_KEY=
# Valores a revisar en Google AI Studio (los modelos y las cuotas cambian con el tiempo).
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
CORS_ALLOWED_ORIGINS=http://localhost:5173
