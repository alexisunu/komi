# Copiar a .env y completar. Nunca subir .env al repositorio.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://komi_user:TU_CLAVE@localhost:5432/komi_db
GEMINI_API_KEY=
# Valores a revisar en Google AI Studio (los modelos y las cuotas cambian con el tiempo).
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
